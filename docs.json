{
  "$schema": "./node_modules/@umami/shiso/docs.schema.json",
  "$shiso": {
    "docsPrefix": "/docs",
    "contentDir": "content/docs",
    "siteUrl": "https://docs.umami.is",
    "locale": "en-US"
  },
  "theme": "shiso",
  "name": "umami",
  "description": "Documentation for Umami, a modern privacy-focused analytics platform.",
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg",
    "href": "https://umami.is/?ref=docs",
    "target": "_blank"
  },
  "favicon": "/favicon.ico",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#2563eb"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "styling": {
    "eyebrows": "section"
  },
  "navbar": {
    "links": [
      {
        "icon": "github",
        "ariaLabel": "Umami on GitHub",
        "href": "https://github.com/umami-software/umami"
      }
    ]
  },
  "footer": {
    "socials": [
      {
        "icon": "github",
        "ariaLabel": "Umami on GitHub",
        "href": "https://github.com/umami-software/umami"
      },
      {
        "icon": "x",
        "ariaLabel": "Umami on X",
        "href": "https://x.com/umami_software"
      },
      {
        "icon": "discord",
        "ariaLabel": "Umami on Discord",
        "href": "https://umami.is/discord"
      }
    ]
  },
  "search": {
    "prompt": "Search the docs...",
    "shortcut": "k"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:image": "https://docs.umami.is/images/docs/screenshot.png",
      "twitter:card": "summary_large_image",
      "twitter:image": "https://docs.umami.is/images/docs/screenshot.png"
    }
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "The page you requested could not be found. Return to the [documentation home](/docs)."
    }
  },
  "redirects": [
    {
      "source": "/docs/guides/measure-campaigns",
      "destination": "https://umami.is/guides/marketing-campaign-tracking"
    },
    {
      "source": "/docs/guides/setup-conversion-goals",
      "destination": "https://umami.is/guides/conversion-tracking"
    },
    {
      "source": "/docs/guides/analyze-traffic-sources",
      "destination": "https://umami.is/guides/marketing-attribution"
    },
    {
      "source": "/docs/guides/compare-traffic-periods",
      "destination": "https://umami.is/guides/website-traffic-analysis"
    },
    {
      "source": "/docs/guides/build-a-funnel",
      "destination": "https://umami.is/guides/conversion-funnels"
    },
    {
      "source": "/docs/guides/monitor-web-vitals",
      "destination": "https://umami.is/guides/core-web-vitals"
    },
    {
      "source": "/docs/guides/core-web-vitals",
