{
  "name": "umami-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "shiso build && node scripts/generate-llms-full.mjs",
    "dev": "vite --config vite.config.ts",
    "preview": "shiso preview --outDir dist/client",
    "check": "shiso check",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@umami/shiso": "^1.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "lint-staged": "^16.2.7",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  }
}
